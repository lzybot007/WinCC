Public Sub uppercase()

   Dim Obj1 As HMIObject
   Dim Prop1 As HMIProperty
   Dim GetSelectedObject()
   Dim i, proptype, lowertext, temp
   
   For Each obj In ActiveDocument.Selection
      Set Obj1 = obj
      proptype = TypeName(Obj1)
      If proptype = "HMIStaticText" Then
      Set Prop1 = Obj1.Properties("Text")
      Else
      Set Prop1 = Obj1.Properties("Text")
      End If
    temp = Prop1.value
    lowertext = UCase(temp)
    Prop1.value = lowertext
           
   Next obj
End Sub
